{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered NEXCORE marketplace user profile with role and contact metadata.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the user." },
        "fullName": { "type": "string", "description": "Full name of the user." },
        "companyName": { "type": "string", "description": "Company or contractor organization name." },
        "email": { "type": "string", "description": "User email address." },
        "phone": { "type": "string", "description": "Contact phone number." },
        "city": { "type": "string", "description": "Primary city or service location." },
        "accountType": {
          "type": "string",
          "enum": [
            "Buyer / Customer",
            "Demolition Contractor / Waste Seller",
            "Recycling Service Provider",
            "Administrator"
          ],
          "description": "Primary marketplace role."
        },
        "isVerified": { "type": "boolean", "description": "True only after administrative verification." },
        "savedListingIds": { "type": "array", "description": "Bounded list of saved material listing IDs." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp (FieldValue.serverTimestamp())." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp (FieldValue.serverTimestamp())." }
      },
      "required": ["userId", "fullName", "companyName", "email", "phone", "city", "accountType", "isVerified", "savedListingIds", "createdAt", "updatedAt"]
    },
    "MarketplaceListing": {
      "title": "MarketplaceListing",
      "description": "A recycled construction material listing (MATERIAL) or C&D waste listing (WASTE).",
      "type": "object",
      "properties": {
        "sellerId": { "type": "string", "description": "UID of the seller who posted the listing." },
        "sellerName": { "type": "string", "description": "Display or company name of the seller." },
        "sellerRole": { "type": "string", "description": "Role of the seller." },
        "sellerVerified": { "type": "boolean", "description": "Whether the seller was verified at listing time." },
        "listingType": {
          "type": "string",
          "enum": ["MATERIAL", "WASTE"],
          "description": "MATERIAL for Buy Materials, WASTE for Sell Waste."
        },
        "title": { "type": "string", "description": "Listing title." },
        "category": { "type": "string", "description": "Material or waste category." },
        "description": { "type": "string", "description": "Detailed description, grading, and specifications." },
        "conditionSpecs": { "type": "string", "description": "Material condition, grading size, and test notes." },
        "quantityTonnes": { "type": "number", "description": "Available or estimated quantity in tonnes." },
        "pricePerTonne": { "type": "number", "description": "Price per tonne (or unit)." },
        "unit": { "type": "string", "description": "Pricing unit, e.g., per tonne." },
        "priceType": {
          "type": "string",
          "enum": ["Fixed Price", "Negotiable"],
          "description": "Whether the price is fixed or negotiable."
        },
        "location": { "type": "string", "description": "City or site location." },
        "preferredCollectionDate": { "type": "string", "description": "Preferred collection or availability date." },
        "deliveryOptions": {
          "type": "string",
          "enum": ["Pickup Only", "Delivery Available", "Pickup or Delivery"],
          "description": "Pickup or delivery logistics arrangement."
        },
        "transportIncluded": { "type": "boolean", "description": "Whether transportation is included in price." },
        "contactPreference": { "type": "string", "description": "Preferred contact method." },
        "status": {
          "type": "string",
          "enum": ["Active", "Paused", "Pending Review", "Removed"],
          "description": "Listing operational status."
        },
        "visibility": {
          "type": "string",
          "enum": ["public", "private"],
          "description": "Query alignment visibility token."
        },
        "isSample": { "type": "boolean", "description": "True if this is demonstration sample data." },
        "imageKey": { "type": "string", "description": "Visual asset key for rendering material illustration." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp (FieldValue.serverTimestamp())." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp (FieldValue.serverTimestamp())." }
      },
      "required": [
        "sellerId", "sellerName", "sellerRole", "sellerVerified", "listingType",
        "title", "category", "description", "conditionSpecs", "quantityTonnes",
        "pricePerTonne", "unit", "priceType", "location", "preferredCollectionDate",
        "deliveryOptions", "transportIncluded", "contactPreference", "status",
        "visibility", "isSample", "imageKey", "createdAt", "updatedAt"
      ]
    },
    "CrusherBooking": {
      "title": "CrusherBooking",
      "description": "Booking request for on-site or nearby mobile crushing and screening service.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of the customer requesting the service." },
        "bookingRef": { "type": "string", "description": "Unique human-readable booking reference." },
        "customerName": { "type": "string", "description": "Customer or contractor name." },
        "contactNumber": { "type": "string", "description": "Customer phone number." },
        "siteLocation": { "type": "string", "description": "Construction site address/city." },
        "wasteType": { "type": "string", "description": "Segregated debris type to process." },
        "estimatedTonnes": { "type": "number", "description": "Estimated debris quantity in tonnes." },
        "siteAccessInfo": { "type": "string", "description": "Heavy equipment access and clearance notes." },
        "preferredDate": { "type": "string", "description": "Preferred service date." },
        "serviceType": {
          "type": "string",
          "enum": ["Crushing", "Screening", "Both"],
          "description": "Required mobile processing service."
        },
        "additionalNotes": { "type": "string", "description": "Additional site or photo notes." },
        "status": {
          "type": "string",
          "enum": [
            "Request Submitted",
            "Under Review",
            "Quotation Sent",
            "Accepted",
            "Scheduled",
            "In Progress",
            "Completed",
            "Cancelled"
          ],
          "description": "Current booking lifecycle status."
        },
        "quotedAmount": { "type": "number", "description": "Assessed service quotation amount." },
        "providerName": { "type": "string", "description": "Assigned service provider name." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp (FieldValue.serverTimestamp())." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp (FieldValue.serverTimestamp())." }
      },
      "required": [
        "userId", "bookingRef", "customerName", "contactNumber", "siteLocation",
        "wasteType", "estimatedTonnes", "siteAccessInfo", "preferredDate",
        "serviceType", "additionalNotes", "status", "quotedAmount",
        "providerName", "createdAt", "updatedAt"
      ]
    },
    "QuotationOrder": {
      "title": "QuotationOrder",
      "description": "Marketplace quotation request and order record between a buyer and seller.",
      "type": "object",
      "properties": {
        "orderRef": { "type": "string", "description": "Unique quotation/order reference code." },
        "buyerId": { "type": "string", "description": "UID of the buyer." },
        "buyerName": { "type": "string", "description": "Name of the buyer." },
        "sellerId": { "type": "string", "description": "UID of the seller." },
        "sellerName": { "type": "string", "description": "Name of the seller." },
        "listingId": { "type": "string", "description": "ID of the referenced marketplace listing." },
        "listingTitle": { "type": "string", "description": "Title of the referenced material/waste." },
        "category": { "type": "string", "description": "Category of the listing." },
        "quantityTonnes": { "type": "number", "description": "Requested quantity in tonnes." },
        "unitPrice": { "type": "number", "description": "Offered price per tonne." },
        "materialSubtotal": { "type": "number", "description": "Material price subtotal." },
        "transportCost": { "type": "number", "description": "Transportation charges." },
        "processingFee": { "type": "number", "description": "Processing or screening fee." },
        "taxAmount": { "type": "number", "description": "Estimated tax amount." },
        "totalAmount": { "type": "number", "description": "Final quoted total amount." },
        "deliveryPreference": { "type": "string", "description": "Pickup or delivery arrangement." },
        "buyerMessage": { "type": "string", "description": "Enquiry message from buyer to seller." },
        "sellerNotes": { "type": "string", "description": "Quotation terms and validity notes from seller." },
        "validityDays": { "type": "number", "description": "Quotation validity period in days." },
        "orderStatus": {
          "type": "string",
          "enum": [
            "Pending",
            "Quote Requested",
            "Quote Received",
            "Accepted",
            "Processing",
            "Ready for Collection",
            "Dispatched",
            "Delivered",
            "Completed",
            "Cancelled"
          ],
          "description": "Current order/quotation workflow status."
        },
        "paymentStatus": { "type": "string", "description": "Payment placeholder status." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp (FieldValue.serverTimestamp())." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp (FieldValue.serverTimestamp())." }
      },
      "required": [
        "orderRef", "buyerId", "buyerName", "sellerId", "sellerName",
        "listingId", "listingTitle", "category", "quantityTonnes", "unitPrice",
        "materialSubtotal", "transportCost", "processingFee", "taxAmount",
        "totalAmount", "deliveryPreference", "buyerMessage", "sellerNotes",
        "validityDays", "orderStatus", "paymentStatus", "createdAt", "updatedAt"
      ]
    },
    "TrustReport": {
      "title": "TrustReport",
      "description": "Trust and safety moderation report for a listing or user.",
      "type": "object",
      "properties": {
        "reporterId": { "type": "string", "description": "UID of the user submitting the report." },
        "targetType": {
          "type": "string",
          "enum": ["Listing", "User"],
          "description": "Type of entity being reported."
        },
        "targetId": { "type": "string", "description": "ID of the reported listing or user." },
        "targetTitle": { "type": "string", "description": "Title or name of the reported entity." },
        "reason": { "type": "string", "description": "Primary report reason." },
        "details": { "type": "string", "description": "Additional report explanation." },
        "status": {
          "type": "string",
          "enum": ["Submitted", "Reviewed", "Resolved"],
          "description": "Moderation review status."
        },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp (FieldValue.serverTimestamp())." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp (FieldValue.serverTimestamp())." }
      },
      "required": [
        "reporterId", "targetType", "targetId", "targetTitle",
        "reason", "details", "status", "createdAt", "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Registered user profiles isolated to the owner or administrator."
    },
    "/listings/{listingId}": {
      "schema": { "$ref": "#/entities/MarketplaceListing" },
      "description": "Recycled material and C&D waste marketplace listings."
    },
    "/crusher_bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/CrusherBooking" },
      "description": "Mobile crusher and screening service booking requests."
    },
    "/quotations/{quotationId}": {
      "schema": { "$ref": "#/entities/QuotationOrder" },
      "description": "Marketplace quotation requests and orders linked to buyers and sellers."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/TrustReport" },
      "description": "Trust and safety reports submitted by users for moderation."
    }
  }
}
